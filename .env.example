# Supabase — Project Settings → API. Required for a production build (see
# nuxt.config.ts's assertEnv). In dev, if left empty, @nuxtjs/supabase logs
# its own warning rather than falling back to a hardcoded project.
NUXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client. Required for a production build
# (see nuxt.config.ts's assertEnv) — the leads/qualifier repositories and the
# admin API routes use the service-role client.
SUPABASE_SERVICE_ROLE_KEY=

# Required for a production build. The primary (EN) domain, used for canonical URLs, hreflang tags, and
# the sitemap. The build fails on purpose if this is missing in production —
# see assertEnv in nuxt.config.ts — rather than silently defaulting to
# localhost.
NUXT_PUBLIC_SITE_URL=https://codepedia.studio

# Optional. The official domain of the Romanian pages (canonical, hreflang,
# sitemap). Left empty, both locales use NUXT_PUBLIC_SITE_URL.
NUXT_PUBLIC_SITE_URL_RO=https://codepedia.md

# Optional. `true` on a preview deployment: every response gets
# `X-Robots-Tag: noindex, nofollow` and robots.txt stops listing the sitemap.
# Leave unset on the live site.
NUXT_PUBLIC_NOINDEX=

# Server-only. Enables the lead-notification email sent from
# layers/leads/server/services/submitLead.ts via core sendMail.
# Left empty, a submitted lead still saves — it just isn't emailed.
RESEND_API_KEY=

# Analytics — optional. Left empty, the consent system stays inert.
NUXT_PUBLIC_GA_ID=
NUXT_PUBLIC_META_PIXEL_ID=

# Qualification modal (layers/qualifier) — set to `true` to swap the hero +
# contact CTAs for the stepped qualifier and enable POST /api/contact. Any other
# value keeps the inline LeadsContactForm. The summary email needs RESEND_API_KEY above.
NUXT_PUBLIC_QUALIFIER_ENABLED=

# Hero background cursor interaction (layers/home). Supported values:
#   - `dot-matrix` (default): Architectural coordinate dot matrix with gravitational lens deflection & amber radial spotlight.
#   - `constellation`: Floating particle nodes with gravitational attraction and dynamic illuminated filaments.
#   - `light-orbs`: Fluid radiant light bodies with mass, spring inertia, and orbital ambient glow.
#   - `none`: Disables the interactive background.
NUXT_PUBLIC_HERO_BG_VARIANT=dot-matrix


# Server-only. Only meaningful on Vercel (nuxt.config.ts's `nitro.vercel.config.bypassToken`),
# where routeRules using `swr`/`isr` (e.g. /proiecte/**, /blog/**) are served by
# Vercel's own edge/prerender cache instead of Nitro's. Any random secret value
# works — generate one with `openssl rand -hex 32`. Set it in the Vercel project
# too, then server/api/admin/revalidate.post.ts can send it back as the
# `x-prerender-revalidate` header to force those routes to refresh on demand.
# Left empty, revalidate.post.ts falls back to clearing Nitro's own storage
# cache (correct off Vercel; a no-op for the ISR-backed routes on Vercel).
VERCEL_ISR_BYPASS_TOKEN=

# Server-only. Vercel production. Vercel Cron calls GET /api/health daily to keep
# the free Supabase plan from pausing; Vercel sends this value as
# `Authorization: Bearer <CRON_SECRET>` automatically. Any random secret works
# (`openssl rand -hex 32`). Left empty, /api/health returns 404.
CRON_SECRET=
