# Supabase — Project Settings → API. Required for a production build (see
# nuxt.config.ts's assertEnv). In dev, if left empty, @nuxtjs/supabase logs
# its own warning rather than falling back to a hardcoded project.
NUXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Required for a production build. Used for canonical URLs, hreflang tags, and
# the sitemap. The build fails on purpose if this is missing in production —
# see assertEnv in nuxt.config.ts — rather than silently defaulting to
# localhost.
NUXT_PUBLIC_SITE_URL=https://codepedia.md

# Server-only. Enables the lead-notification email sent from
# layers/leads/server/services/submitLead.ts via core sendMail.
# Left empty, a submitted lead still saves — it just isn't emailed.
RESEND_API_KEY=

# Analytics — optional. Left empty, the consent system stays inert.
NUXT_PUBLIC_GA_ID=
NUXT_PUBLIC_META_PIXEL_ID=

# Qualification modal (layers/qualifier) — set to `true` to swap the hero +
# contact CTAs for the stepped qualifier and enable POST /api/contact. Any other
# value keeps the inline LeadsContactForm. The summary email needs RESEND_API_KEY above.
NUXT_PUBLIC_QUALIFIER_ENABLED=
